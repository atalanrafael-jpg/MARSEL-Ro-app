# MARSEL / RO App read-only audit configuration
ROAPP_API_KEY=
ROAPP_API_BASE=https://api.roapp.io/v2
ROAPP_DOCS_INDEX=https://roapp.readme.io/llms.txt
ROAPP_TIMEOUT=30
ROAPP_MIN_REQUEST_INTERVAL=0.34
ROAPP_MAX_RETRIES=3
ROAPP_RETRY_BASE_SECONDS=0.75
MARSEL_MAX_DOCS=300

# OpenAI Ads Conversions API (server-side only)
# Get the Pixel ID and CAPI key from Ads Manager > Conversions.
# NEVER expose OPENAI_ADS_CONVERSIONS_API_KEY to browser/client code.
OPENAI_ADS_PIXEL_ID=
OPENAI_ADS_CONVERSIONS_API_KEY=
OPENAI_ADS_BASE_URL=https://bzr.openai.com
OPENAI_ADS_VALIDATE_ONLY=false
OPENAI_ADS_DEFAULT_CURRENCY=RUB
OPENAI_ADS_SOURCE_URL=
OPENAI_ADS_TIMEOUT_SECONDS=15

# Legacy AI PoC configuration (only for the legacy draft-generation scripts)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GH_PAT=
GITHUB_REPOSITORY=atalanrafael-jpg/Ro-app
AI_TOPIC=
AI_VARIANTS=3
