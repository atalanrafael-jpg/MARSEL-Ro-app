# RO App
ROAPP_API_KEY=
ROAPP_BASE_URL=https://api.roapp.io/v2
ROAPP_TIMEOUT_SECONDS=30
ROAPP_MAX_REQUESTS_PER_SECOND=3

# OpenAI Ads Conversions API
# Obtain both values from Ads Manager > Conversions.
# Do NOT put the Conversions API key in frontend/browser code.
OPENAI_ADS_PIXEL_ID=
OPENAI_ADS_CONVERSIONS_API_KEY=
OPENAI_ADS_BASE_URL=https://bzr.openai.com
# Keep true while validating the integration. Set false only after validation succeeds.
OPENAI_ADS_VALIDATE_ONLY=true
OPENAI_ADS_DEFAULT_CURRENCY=RUB
# Required for web events; set to the site's conversion/confirmation URL base if appropriate.
OPENAI_ADS_SOURCE_URL=
OPENAI_ADS_TIMEOUT_SECONDS=15
