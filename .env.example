# MARSEL / RO App read-only audit configuration
ROAPP_API_KEY=
ROAPP_BASE_URL=https://api.roapp.io/v2
ROAPP_TIMEOUT_SECONDS=30
ROAPP_MAX_REQUESTS_PER_SECOND=3
ROAPP_MAX_RETRIES=3
ROAPP_RETRY_BASE_SECONDS=0.75

# OpenAI Ads Conversions API (server-side only)
OPENAI_ADS_PIXEL_ID=
OPENAI_ADS_CONVERSIONS_API_KEY=
OPENAI_ADS_BASE_URL=https://bzr.openai.com
# false = production reporting; true = validation-only smoke tests
OPENAI_ADS_VALIDATE_ONLY=false
OPENAI_ADS_INTEGRATION_SOURCE=marsel_roapp
OPENAI_ADS_DEFAULT_CURRENCY=RUB
# Required for web events; origin + pathname are sent, query strings/fragments are stripped.
OPENAI_ADS_SOURCE_URL=
OPENAI_ADS_TIMEOUT_SECONDS=15

# ChatGPT / Codex MCP
# Local Codex stdio does not use these values.
# Remote ChatGPT MCP HTTP mode requires an OAuth 2.1/OIDC issuer and HTTPS resource URL.
MCP_HTTP_ENABLED=false
MCP_RESOURCE_SERVER_URL=https://your-domain.example.com/mcp
MCP_AUTH_ISSUER=https://your-issuer.example.com/
MCP_AUTH_JWKS_URL=https://your-issuer.example.com/.well-known/jwks.json
MCP_REQUIRED_SCOPES=["roapp:read"]

# Legacy AI PoC configuration (only for legacy draft-generation scripts)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GH_PAT=
GITHUB_REPOSITORY=atalanrafael-jpg/Ro-app
AI_TOPIC=
AI_VARIANTS=3
